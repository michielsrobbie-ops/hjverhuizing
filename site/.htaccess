# HJ Verhuizing - statische site (vervangt WordPress)
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType image/webp .webp
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# altijd https en zonder www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# index.html niet in de url
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# map zonder slash: slash erachter (zoals WordPress deed)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

# oude WordPress-adressen
RewriteRule ^(feed|comments/feed)/?$ /kennisbank/ [R=301,L]
RewriteRule ^[^/]+/feed/?$ /kennisbank/ [R=301,L]
RewriteRule ^(category/.*|author/.*|blog/?)$ /kennisbank/ [R=301,L]
RewriteRule ^(home|homepage)/?$ / [R=301,L]
RewriteRule ^(sitemap_index|page-sitemap|post-sitemap|author-sitemap)\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-json|wp-includes) - [G,L]
RewriteCond %{QUERY_STRING} ^p=[0-9]+ [OR]
RewriteCond %{QUERY_STRING} ^page_id=[0-9]+
RewriteRule ^$ /? [R=301,L]

# oude afbeeldingen (Google Afbeeldingen) naar de nieuwe WebP-versies
RewriteRule ^wp-content/uploads/2023/12/closeup-man-carrying-cardboard-boxes-while-relocating-into-new-apartment-scaled(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/verhuisdozen-dragen-1600.webp [R=301,L]
RewriteRule ^wp-content/uploads/2024/06/002(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/verhuizers-voordeur-1393.webp [R=301,L]
RewriteRule ^wp-content/uploads/2024/06/003-1(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/kennismaking-voordeur-1600.webp [R=301,L]
RewriteRule ^wp-content/uploads/2024/06/75-1(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/verhuizer-met-doos-1600.webp [R=301,L]
RewriteRule ^wp-content/uploads/2024/06/75-scaled(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/verhuizer-met-doos-staand-1600.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/01/IMG_6479(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/verhuizer-uitgesneden-704.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/01/boxes-in-new-home(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/dozen-nieuwe-woning-1280.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/01/moving-a-young-couple-3-e1670171915618(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/stel-tussen-verhuisdozen-1280.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/01/moving(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/stel-lege-woning-1280.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/06/deventer-verhuisbedrijf(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/verhuizer-steekwagen-woonkamer-1536.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/06/senioren-verhuis(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/verhuiswagen-laden-1536.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/06/verhuis-zwolle(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/verhuiswagen-laden-2-1536.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/06/verhuisbedrijf-hattem(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/verhuiswagen-laden-3-1536.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/06/verhuisbedrijf-meppel(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/verhuizer-draagt-doos-1536.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/06/verhuisbedrijf-zwolle(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/team-laadt-verhuiswagen-1536.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/06/verhuisservice-hattem(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/verhuizer-verhuisdoos-binnen-1536.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/06/verhuisservice-meppel(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/spiegel-dragen-1536.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/06/verhuisservice-zwolle(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/kast-dragen-1536.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/06/verhuizing-1(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/meubel-dragen-1536.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/06/verhuizing-e1781340699453(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/hj-verhuizing-shirt-1536.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/06/verhuizing-hattem(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/verhuiswagen-dozen-1536.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/06/verhuizing-zwolle(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/verhuiswagen-laden-4-1536.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/06/zwolle-verhuisdienst(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/verhuiswagen-vol-1536.webp [R=301,L]
RewriteRule ^wp-content/uploads/2026/06/zwolle-verhuisservice(-[0-9]+x[0-9]+)?\.(jpe?g|png|webp)$ /img/steekwagen-dozen-1536.webp [R=301,L]
RewriteRule ^wp-content/ - [G,L]
</IfModule>

# beveiliging
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
<FilesMatch "^(\.|build|.*\.(py|md|json|log)$)">
  <IfModule mod_authz_core.c>Require all denied</IfModule>
</FilesMatch>
<FilesMatch "^site\.webmanifest$">
  <IfModule mod_authz_core.c>Require all granted</IfModule>
</FilesMatch>

# cache: html kort, css/js/afbeeldingen/fonts lang (css/js hebben ?v= in de link)
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 hour"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml application/xml text/plain application/manifest+json
</IfModule>
